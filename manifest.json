{
  "manifest_version": 3,
  "name": "Price Tracker",
  "version": "0.1.13",
  "description": "Track product prices and get notified when they change.",
  "permissions": ["storage", "alarms", "notifications", "activeTab", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["dist/background.js"]
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "Firefox-Price-Tracker@exzzy22",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": [],
        "other": ["This extension does not collect personal user data."]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content_script.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
